# UsArr — example environment file
#
# Copy to .env and edit.  `.env` is gitignored; NEVER commit a real key.
# Every value below is a PLACEHOLDER.  Nothing here is a working credential.
# Full reference, including precedence rules and licensing constraints:
#   docs/CONFIGURATION.md
#
# Any variable named *_API_KEY, *_KEY, *_PIN or *_TOKEN also accepts a *_FILE
# twin pointing at a file (Docker/Kubernetes secrets), e.g.
#   USARR_SECRET_KEY_FILE=/run/secrets/usarr_key
# Setting both a variable and its _FILE twin is a startup error, not a fallback.
#
# STATUS: pre-alpha.  Variables are the spec the implementation is built to;
# none of them are read by shipped code yet.

# ─────────────────────────────────────────────────────────────────────────────
# Core process
# ─────────────────────────────────────────────────────────────────────────────

# Persistent state: config.yaml, services.yaml, the SQLite DB, secret.key.
# THIS IS THE VOLUME TO BACK UP.  Never place it on NFS/SMB — SQLite WAL needs
# real filesystem locking and shared memory.
USARR_CONFIG_DIR=/config

# Regenerable state: image cache, metadata cache, logs, plugins.
# Defaults to USARR_CONFIG_DIR when unset (single-volume Docker installs).
USARR_DATA_DIR=/data

# Explicit config file path.  Defaults to $USARR_CONFIG_DIR/config.yaml.
#USARR_CONFIG_FILE=/config/config.yaml

# Declarative service provisioning for headless/IaC installs.  Entries become
# read-only in the UI.  Defaults to $USARR_CONFIG_DIR/services.yaml if present.
#USARR_SERVICES_FILE=/config/services.yaml

# Interface to bind.  Use 127.0.0.1 when a reverse proxy runs on the same host.
USARR_BIND_ADDRESS=0.0.0.0

# HTTP listen port.  8484 avoids every default port UsArr talks to
# (8989/7878/8686/8787/9696/6969/5299/8096/32400/8080/6789/9091/8112/6767/5055/7700).
USARR_PORT=8484

# Sub-path when reverse-proxied, e.g. https://home.example/usarr
# Leading slash, no trailing slash.  Must match the proxy exactly.  Empty = root.
USARR_URL_BASE=

# trace | debug | info | warn | error
USARR_LOG_LEVEL=info

# auto | text | json   (auto = text on a TTY, JSON otherwise)
USARR_LOG_FORMAT=auto

# Log rotation inside $USARR_DATA_DIR/logs/
USARR_LOG_MAX_SIZE_MB=10
USARR_LOG_MAX_FILES=5

# ─────────────────────────────────────────────────────────────────────────────
# Security — read docs/CONFIGURATION.md §3 before touching these
# ─────────────────────────────────────────────────────────────────────────────

# MASTER KEY.  Wraps the data-encryption keys protecting every stored service
# credential (*Arr API keys, Jellyfin tokens, download-client passwords) and
# TOTP secrets.  32 random bytes, base64.  REQUIRED once the DB holds secrets.
#
# Generate one — do NOT use the placeholder below:
#   openssl rand -base64 32
#
# Lose it and every stored credential is unrecoverable (library data survives;
# you re-paste every API key).  Back it up somewhere other than the database
# backup — storing both together defeats encryption at rest.
USARR_SECRET_KEY=REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_base64_32

# Preferred in Docker/Kubernetes.  Mutually exclusive with USARR_SECRET_KEY.
#USARR_SECRET_KEY_FILE=/run/secrets/usarr_key

# CIDRs whose X-Forwarded-* and forwarded auth headers are believed.
# EMPTY MEANS TRUST NOTHING — the peer IP is used as-is and forward-auth is
# refused.  Set this to your proxy's network ONLY, never 0.0.0.0/0.
# It gates rate-limit bucketing, audit-log actor IPs, and forward-auth.
USARR_TRUSTED_PROXIES=

# Forward-auth (Authelia / Authentik / Traefik).  Refuses to enable while
# USARR_TRUSTED_PROXIES is empty.  Header names are never guessed — name them.
USARR_FORWARD_AUTH_ENABLED=false
#USARR_FORWARD_AUTH_USER_HEADER=Remote-User
#USARR_FORWARD_AUTH_GROUPS_HEADER=Remote-Groups
#USARR_FORWARD_AUTH_EMAIL_HEADER=Remote-Email

# Allow self-registration at /signup.  The first-run wizard creates the owner
# account regardless of this setting.
USARR_ENABLE_SIGNUP=false

# Session lifetimes (Go duration strings).  Both are enforced: idle and absolute.
USARR_SESSION_IDLE_TIMEOUT=168h
USARR_SESSION_ABSOLUTE_TIMEOUT=720h

# Serve HTTPS directly.  Both or neither.  Prefer terminating TLS at a proxy.
#USARR_TLS_CERT_FILE=/config/tls/cert.pem
#USARR_TLS_KEY_FILE=/config/tls/key.pem

# Per-host acceptance of self-signed certs on OUTBOUND calls.  *Arr apps serve
# HTTPS with a self-signed cert on port 9898 by default.  Per-host on purpose —
# there is deliberately no global "insecure" switch.
#USARR_ALLOW_INSECURE_TLS_HOSTS=sonarr.lan:9898,radarr.lan:9898

# ─────────────────────────────────────────────────────────────────────────────
# Metadata providers — all optional; see docs/CONFIGURATION.md §4 for licensing
# ─────────────────────────────────────────────────────────────────────────────

# TMDB v3 API key — film/TV metadata and artwork.
# Register: https://www.themoviedb.org/settings/api
# Free for non-commercial use.  Mandatory attribution in the UI, and cached
# TMDB data may not be kept longer than 6 months.  UsArr does not ship a shared
# key: the TMDB terms forbid sublicensing.  Bring your own.
#USARR_TMDB_API_KEY=your_tmdb_v3_api_key_here

# TMDB v4 read access token, if you prefer bearer auth to the v3 key.
#USARR_TMDB_READ_TOKEN=your_tmdb_v4_read_access_token_here

# Max age of cached TMDB rows.  Clamped to 4320h (6 months) by TMDB's terms.
USARR_TMDB_CACHE_TTL=720h

# TheTVDB v4.  THERE IS NO FREE TIER: either a negotiated commercial contract,
# or a "user-supported" key where each end user holds a paid subscription and
# supplies a PIN.  https://thetvdb.com/api-information
# Leave unset — the default TV path is TMDB + TVmaze.
#USARR_TVDB_API_KEY=your_thetvdb_v4_api_key_here
#USARR_TVDB_PIN=your_thetvdb_subscriber_pin_here

# Contact string appended to UsArr's outbound User-Agent.
# MusicBrainz REQUIRES an identifying UA with contact info (1 req/s, 503 above).
# Open Library raises you from 1 to 3 req/s when you send one.
# Set this if you use either provider.
#USARR_METADATA_USER_AGENT=UsArr/0.1 ( you@example.com )

# Comic Vine (fallback comics provider; Metron is preferred and configured in UI)
# https://comicvine.gamespot.com/api/
#USARR_COMICVINE_API_KEY=your_comicvine_api_key_here

# Fanart.tv artwork.  https://fanart.tv/get-an-api-key/
#USARR_FANART_API_KEY=your_fanart_project_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Search backend (optional plugin)
# ─────────────────────────────────────────────────────────────────────────────

# Unset = built-in SQLite FTS5 index.  That is the supported default, not a
# fallback.  Meilisearch is for large libraries.
#USARR_MEILISEARCH_URL=http://meilisearch:7700
#USARR_MEILISEARCH_KEY=your_meilisearch_api_key_here
#USARR_MEILISEARCH_INDEX_PREFIX=usarr

# ─────────────────────────────────────────────────────────────────────────────
# Service bootstrap — CREATE-IF-ABSENT ONLY
#
# These apply only on a run where no instance of that kind exists yet.  They
# never overwrite an instance you configured in the UI and never resurrect one
# you deleted.  They exist so a single `docker run` lands you in a working app.
# For real infrastructure-as-code use services.yaml (USARR_SERVICES_FILE).
#
# For a second instance of a kind, append _2, _3 (USARR_SONARR_2_URL).
# *Arr API keys are 32 hex chars, found at Settings → General → Security.
# ─────────────────────────────────────────────────────────────────────────────

# Jellyfin — primary playback + identity backend.  Port 8096.
# API key: Dashboard → API Keys.  If URL is set but no key, the setup wizard can
# mint UsArr's own key via /Auth/Keys given admin credentials, so no admin
# password is ever stored.
#USARR_JELLYFIN_URL=http://jellyfin:8096
#USARR_JELLYFIN_API_KEY=your_jellyfin_api_key_here

# Sonarr — TV.  Port 8989, API base /api/v3.
#USARR_SONARR_URL=http://sonarr:8989
#USARR_SONARR_API_KEY=your_32_hex_char_sonarr_api_key

# Radarr — movies.  Port 7878, API base /api/v3.
#USARR_RADARR_URL=http://radarr:7878
#USARR_RADARR_API_KEY=your_32_hex_char_radarr_api_key

# Lidarr — music.  Port 8686, API base /api/v1 (not v3).
#USARR_LIDARR_URL=http://lidarr:8686
#USARR_LIDARR_API_KEY=your_32_hex_char_lidarr_api_key

# Prowlarr — indexers.  Port 9696, API base /api/v1 (not v3).
# The authoritative source of the usenet-vs-torrent protocol tag.
#USARR_PROWLARR_URL=http://prowlarr:9696
#USARR_PROWLARR_API_KEY=your_32_hex_char_prowlarr_api_key

# LazyLibrarian — books/magazines/comics.  Port 5299.
# Key must be EXACTLY 32 characters or it returns "503 Invalid API key".
# Prefer its read-only key unless UsArr needs to queue books.
#USARR_LAZYLIBRARIAN_URL=http://lazylibrarian:5299
#USARR_LAZYLIBRARIAN_API_KEY=your_32_char_lazylibrarian_api_key

# Readarr — RETIRED UPSTREAM (repo archived 2025-06-27, metadata backend gone).
# The /api/v1 surface still responds, so an existing library can be read.
# Do not start a new book library on it.
#USARR_READARR_URL=http://readarr:8787
#USARR_READARR_API_KEY=your_32_hex_char_readarr_api_key

# Whisparr — adult.  Port 6969, /api/v3, Sonarr-shaped.
#USARR_WHISPARR_URL=http://whisparr:6969
#USARR_WHISPARR_API_KEY=your_32_hex_char_whisparr_api_key

# Bazarr — subtitles.  Port 6767, header X-API-KEY.
#USARR_BAZARR_URL=http://bazarr:6767
#USARR_BAZARR_API_KEY=your_bazarr_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Container conventions (LinuxServer.io).  Consumed by the container entrypoint
# before it drops privileges — the Go binary never reads these.
# ─────────────────────────────────────────────────────────────────────────────

# Must own $USARR_CONFIG_DIR and $USARR_DATA_DIR.
PUID=1000

# Match your media group so UsArr can read mounted libraries.
PGID=1000

# IANA timezone for logs, schedules and calendar rendering.
TZ=Etc/UTC

# umask for files UsArr creates.
UMASK=022

# ─────────────────────────────────────────────────────────────────────────────
# Development only — not read in production builds
# ─────────────────────────────────────────────────────────────────────────────

# Opt in to tests behind the `integration` build tag.  Requires a live *Arr
# stack; never set in CI (no Docker daemon there).  See docs/DEVELOPMENT.md §8.
#USARR_INTEGRATION=1

# Put go-vcr into record mode: real HTTP goes out and cassettes are written to
# testdata/cassettes/.  Secrets are scrubbed by a recorder hook before write.
#USARR_RECORD=1
