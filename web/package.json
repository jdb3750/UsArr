{
	"name": "usarr-web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/externalise-inline-bootstrap.mjs && node scripts/sync-embed.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"bench:list": "node scripts/list-bench.mjs",
		"test:freeze": "node scripts/freeze-check.mjs",
		"probe:pointer": "node scripts/pointer-dispatch-probe.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.2"
		}
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/node": "^22.20.1",
		"eslint": "10.8.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"playwright-core": "1.56.1",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.56.9",
		"svelte-check": "4.7.6",
		"typescript": "5.9.3",
		"typescript-eslint": "8.67.0",
		"vite": "8.2.1",
		"vitest": "4.1.10"
	}
}
